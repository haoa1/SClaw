#!/usr/bin/env python3
"""
Fetch stock data from Sclaw SQLite DB and run ML factor screener.

Usage:
  python3 /root/sclaw/ml_screener/fetch_and_screen.py [limit=100] [--min_score=0]
  python3 /root/sclaw/ml_screener/fetch_and_screen.py --quick  (latest 20 stocks with most data)

Output: JSON with ranked results to stdout, summary to stderr.

Uses Sclaw's stock_history.db tables:
  - stock_info: code, name, market (5,721 stocks)
  - stock_daily: code, date, open, high, low, close, volume, amount, change_pct, turnover_rate (~5M records)
"""

import json, sys, os, subprocess, sqlite3

SCLAW_DATA_DIR = "/root/sclaw/data"
ML_SCREENER = "/root/sclaw/ml_screener/ml_screener.py"
IDX_DAILY = "/root/sclaw/ml_screener/sh000001_daily.json"

_IDX_CACHE = None

def load_idx_daily():
    """Load SSE index daily closes → {date: close} with ffill (nearest prior)."""
    global _IDX_CACHE
    if _IDX_CACHE is not None:
        return _IDX_CACHE
    dmap = {}
    if os.path.exists(IDX_DAILY):
        try:
            d = json.load(open(IDX_DAILY))
            last = None
            for dt, cl in zip(d.get("dates", []), d.get("closes", [])):
                if cl is not None:
                    try:
                        last = float(cl)
                    except (TypeError, ValueError):
                        pass
                dmap[dt] = last
        except Exception as e:
            print(f"⚠ index load failed: {e}", file=sys.stderr)
    _IDX_CACHE = dmap
    return dmap

def align_idx_close(kline_dates):
    """Return idx_close list aligned to kline dates (ffill, 0 if missing)."""
    dmap = load_idx_daily()
    return [dmap.get(d, 0.0) for d in kline_dates]

def get_db():
    db_path = os.path.join(SCLAW_DATA_DIR, "stock_history.db")
    if not os.path.exists(db_path):
        print(f"❌ DB not found: {db_path}", file=sys.stderr)
        sys.exit(1)
    conn = sqlite3.connect(db_path)
    conn.row_factory = sqlite3.Row
    return conn

def fetch_stocks(conn, limit=100):
    """Fetch stocks that have at least 60 days of kline data."""
    print(f"  Finding stocks with 60+ data days...", file=sys.stderr)
    
    # Get stocks with enough data (limit to top stocks by data coverage)
    cursor = conn.execute("""
        SELECT code, COUNT(*) as days 
        FROM stock_daily 
        GROUP BY code 
        HAVING days >= 60 
        ORDER BY days DESC 
        LIMIT ?
    """, (limit * 2,))  # Fetch extra to filter
    
    candidates = cursor.fetchall()
    print(f"  Found {len(candidates)} stocks with 60+ days", file=sys.stderr)
    
    stocks = []
    for row in candidates:
        code = row["code"]
        # Get stock info
        info = conn.execute("SELECT * FROM stock_info WHERE code=?", (code,)).fetchone()
        if not info:
            continue
        
        # Get latest kline data (last 60 days)
        klines = conn.execute("""
            SELECT date, open, high, low, close, volume, amount, change_pct, turnover_rate
            FROM stock_daily 
            WHERE code=? 
            ORDER BY date DESC 
            LIMIT 60
        """, (code,)).fetchall()
        
        if len(klines) < 20:  # Need at least 20 days for MA20
            continue
        
        klines.reverse()
        latest = klines[-1]
        
        # Build stock object
        closes = [k["close"] for k in klines]
        vols = [k["volume"] for k in klines]
        avg_vol_20 = sum(vols[-20:]) / 20 if len(vols) >= 20 else 1
        
        stock = {
            "code": code,
            "name": info["name"],
            "market": info["market"],
            "price": latest["close"],
            "change_percent": latest["change_pct"] or 0,
            "volume": latest["volume"],
            "turnover": latest["amount"],
            "volume_ratio": latest["volume"] / avg_vol_20 if avg_vol_20 > 0 else 1.0,
            "turnover_rate": latest["turnover_rate"] or 0,
            "pe": None,   # Not stored in this DB
            "pb": None,
            "market_cap": None,
            "high": latest["high"],
            "low": latest["low"],
            "kline": [
                {
                    "date": k["date"], 
                    "open": k["open"], 
                    "high": k["high"], 
                    "low": k["low"], 
                    "close": k["close"], 
                    "volume": k["volume"],
                    "amount": k["amount"] if "amount" in k.keys() else 0,
                    "change_pct": k["change_pct"] if "change_pct" in k.keys() else 0
                } for k in klines
            ],
            "idx_close": align_idx_close([k["date"] for k in klines]),
        }
        stocks.append(stock)
        
        if len(stocks) >= limit:
            break
    
    return stocks

def run_ml_screener(stocks):
    """Pipe stocks to ml_screener.py and return results."""
    input_json = json.dumps(stocks)
    result = subprocess.run(
        [sys.executable, ML_SCREENER],
        input=input_json,
        capture_output=True,
        text=True,
        timeout=120
    )
    if result.returncode != 0:
        print(f"❌ ML screener error: {result.stderr[:500]}", file=sys.stderr)
        return {"total": 0, "results": []}
    
    return json.loads(result.stdout)

def main():
    # Parse args
    limit = 100
    min_score = 0
    quick = False
    for arg in sys.argv[1:]:
        if arg.startswith("limit="):
            limit = int(arg.split("=")[1])
        elif arg.startswith("--min-score="):
            min_score = float(arg.split("=")[1])
        elif arg == "--quick":
            quick = True
            limit = 20
    
    print(f"🔍 ML Screener: analyzing {limit} stocks...", file=sys.stderr)
    
    conn = get_db()
    stocks = fetch_stocks(conn, limit=limit)
    conn.close()
    
    if not stocks:
        print(json.dumps({"total": 0, "results": [], "error": "No stock data with 60+ days available"}, ensure_ascii=False))
        sys.exit(0)
    
    print(f"📊 Running ML factor model on {len(stocks)} stocks...", file=sys.stderr)
    
    results = run_ml_screener(stocks)
    
    # Filter by min_score
    if min_score > 0 and results.get("results"):
        results["results"] = [r for r in results["results"] if r["score"] >= min_score]
        results["total"] = len(results["results"])
    
    # Print summary to stderr
    top = results.get("results", [])[:5]
    if top:
        print(f"\n🏆 Top {len(top)} ML picks:", file=sys.stderr)
        for r in top:
            sigs = " ".join(r.get("signals", []))
            print(f"  #{r['rank']} {r['code']} {r['name']:8s} | 评分:{r['score']:5.1f} | 涨跌:{r.get('change_percent',0):+6.2f}% | {sigs}", file=sys.stderr)
    else:
        print(f"\nNo stocks scored above {min_score}", file=sys.stderr)
    
    # Full JSON to stdout
    print(json.dumps(results, ensure_ascii=False, indent=2))

if __name__ == "__main__":
    main()
