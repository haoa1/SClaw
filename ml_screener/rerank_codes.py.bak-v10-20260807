#!/usr/bin/env python3
"""
给指定股票池打 ML 分（双模型叠加用）

用途：scheduler 跑缠论策略前，先对候选池调用 ML v10 模型打分，
     只保留 ML 分 >= minScore 的股票，实现"ML 高分池 + 缠论确认"。

输入 stdin: {"codes": ["600519", "000001", ...]}
输出 stdout: {"results": [{"code","name","score","mlp_score"}...], "total": N, "scored": N}

数据源：与 fetch_and_screen.py 相同的 Sclaw SQLite (stock_history.db)
复用：ml_screener.py 的 v10 模型打分（8模型集成）
"""
import json, sys, os, subprocess, sqlite3

SCLAW_DATA_DIR = "/root/sclaw/data"
ML_SCREENER = "/root/sclaw/ml_screener/ml_screener.py"


def get_db():
    db_path = os.path.join(SCLAW_DATA_DIR, "stock_history.db")
    if not os.path.exists(db_path):
        print(f"❌ DB not found: {db_path}", file=sys.stderr)
        sys.exit(1)
    conn = sqlite3.connect(db_path)
    conn.row_factory = sqlite3.Row
    return conn


def fetch_stocks_by_codes(conn, codes):
    """按 code 列表从 SQLite 拉 kline 并构造 ML 输入对象（与 fetch_and_screen 格式一致）"""
    stocks = []
    code_set = list(dict.fromkeys(codes))  # 去重保序
    for code in code_set:
        info = conn.execute("SELECT * FROM stock_info WHERE code=?", (code,)).fetchone()
        if not info:
            continue
        klines = conn.execute("""
            SELECT date, open, high, low, close, volume, amount, change_pct, turnover_rate
            FROM stock_daily WHERE code=? ORDER BY date DESC LIMIT 60
        """, (code,)).fetchall()
        if len(klines) < 20:
            continue
        klines.reverse()
        latest = klines[-1]
        closes = [k["close"] for k in klines]
        vols = [k["volume"] for k in klines]
        avg_vol_20 = sum(vols[-20:]) / 20 if len(vols) >= 20 else 1
        stock = {
            "code": code,
            "name": info["name"],
            "market": info["market"],
            "price": latest["close"],
            "change_percent": latest["change_pct"] or 0,
            "volume": latest["volume"],
            "turnover": latest["amount"],
            "volume_ratio": latest["volume"] / avg_vol_20 if avg_vol_20 > 0 else 1.0,
            "turnover_rate": latest["turnover_rate"] or 0,
            "pe": None,
            "pb": None,
            "market_cap": None,
            "high": latest["high"],
            "low": latest["low"],
            "kline": [
                {
                    "date": k["date"], "open": k["open"], "high": k["high"],
                    "low": k["low"], "close": k["close"], "volume": k["volume"],
                    "amount": k["amount"] if "amount" in k.keys() else 0,
                    "change_pct": k["change_pct"] if "change_pct" in k.keys() else 0,
                } for k in klines
            ]
        }
        stocks.append(stock)
    return stocks


def main():
    raw = sys.stdin.read()
    try:
        data = json.loads(raw)
    except Exception:
        print(json.dumps({"total": 0, "results": [], "error": "bad stdin json"}))
        sys.exit(0)

    codes = data.get("codes", [])
    if not codes:
        print(json.dumps({"total": 0, "results": [], "scored": 0}))
        sys.exit(0)

    conn = get_db()
    stocks = fetch_stocks_by_codes(conn, codes)
    conn.close()

    if not stocks:
        print(json.dumps({"total": 0, "results": [], "scored": 0}))
        sys.exit(0)

    # 调用 ml_screener.py 核心模型打分（stdin 传股票列表）
    input_json = json.dumps(stocks)
    try:
        result = subprocess.run(
            [sys.executable, ML_SCREENER],
            input=input_json,
            capture_output=True,
            text=True,
            timeout=300,
        )
    except subprocess.TimeoutExpired:
        print(json.dumps({"total": 0, "results": [], "scored": len(stocks), "error": "ml_screener timeout"}))
        sys.exit(0)

    if result.returncode != 0:
        print(json.dumps({
            "total": 0, "results": [], "scored": len(stocks),
            "error": result.stderr[:300],
        }))
        sys.exit(0)

    try:
        out = json.loads(result.stdout)
    except Exception:
        print(json.dumps({"total": 0, "results": [], "scored": len(stocks), "error": "bad ml output"}))
        sys.exit(0)

    out["scored"] = len(stocks)
    print(json.dumps(out, ensure_ascii=False))


if __name__ == "__main__":
    main()
