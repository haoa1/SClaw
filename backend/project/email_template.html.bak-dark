<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<style>
body { font-family: -apple-system, 'PingFang SC', 'Microsoft YaHei', sans-serif; background: #0f172a; color: #f1f5f9; margin: 0; padding: 16px; }
.container { max-width: 800px; margin: 0 auto; }
.header { background: linear-gradient(135deg, #1e293b, #0f172a); padding: 24px; border-radius: 12px; margin-bottom: 16px; text-align: center; border: 1px solid #475569; }
.header h1 { color: #fbbf24; margin: 0 0 8px; font-size: 24px; }
.header .sub { color: #cbd5e1; font-size: 14px; }
.section { background: #1e293b; border-radius: 12px; padding: 16px; margin-bottom: 16px; border: 1px solid #475569; }
.section h2 { color: #fbbf24; font-size: 17px; margin: 0 0 12px; padding-bottom: 8px; border-bottom: 1px solid #475569; }
table { width: 100%; border-collapse: collapse; font-size: 14px; }
th { background: #334155; color: #fbbf24; padding: 10px 8px; text-align: center; font-weight: 600; }
td { padding: 8px; text-align: center; border-bottom: 1px solid #1e293b; }
tr:nth-child(even) { background: #0f172a40; }
tr:hover { background: #33415560; }
.buy { color: #34d399; }
.sell { color: #f87171; }
.neutral { color: #cbd5e1; }
.score-high { background: #065f46; color: #34d399; padding: 2px 8px; border-radius: 4px; font-weight: bold; }
.score-mid { background: #92400e; color: #fbbf24; padding: 2px 8px; border-radius: 4px; font-weight: bold; }
.score-low { background: #7f1d1d; color: #fca5a5; padding: 2px 8px; border-radius: 4px; font-weight: bold; }
.rank-1 { color: #fbbf24; font-weight: bold; }
.rank-2 { color: #cbd5e1; font-weight: bold; }
.rank-3 { color: #d97706; font-weight: bold; }
.card { background: #0f172a; border-radius: 8px; padding: 12px; margin-bottom: 8px; border: 1px solid #334155; }
.card h3 { margin: 0 0 8px; font-size: 14px; }
.good { color: #34d399; }
.warn { color: #fbbf24; }
.bad { color: #f87171; }
.info-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 8px; }
.info-item { text-align: center; padding: 8px; background: #1e293b; border-radius: 6px; }
.info-item .label { color: #cbd5e1; font-size: 14px; }
.info-item .value { font-size: 16px; font-weight: bold; margin-top: 2px; }
.footer { text-align: center; padding: 16px; color: #94a3b8; font-size: 13px; }
.market-summary { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 8px; margin-bottom: 12px; }
.market-item { text-align: center; padding: 10px; border-radius: 6px; }
.market-up { background: #065f4620; border: 1px solid #065f46; }
.market-down { background: #7f1d1d20; border: 1px solid #7f1d1d; }
.market-flat { background: #1e293b; border: 1px solid #334155; }
.tag { display: inline-block; padding: 1px 6px; border-radius: 3px; font-size: 14px; margin: 1px; }
.tag-buy { background: #065f46; color: #34d399; }
.tag-risk { background: #7f1d1d; color: #fca5a5; }
.tag-trend { background: #92400e; color: #fbbf24; }
.tag-div { background: #312e81; color: #a5b4fc; }
</style>
</head>
