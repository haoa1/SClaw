# ============================================
# SClaw - Environment Configuration
# ============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================

# ---- Required: Stock Data API ----
# Get your free token at https://tushare.pro
TUSHARE_TOKEN=your_tushare_pro_token

# ---- Optional: AI Agent (DeepSeek) ----
# Required if you want the AI chat & tool-calling agent
DEEPSEEK_API_KEY=sk-your_deepseek_api_key
LLM_MODEL=deepseek-chat

# ---- Optional: Email Reports (SMTP) ----
# Required only if you use scheduled screening reports
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=your_email@example.com
SMTP_PASS=your_smtp_password

# ---- Optional: Backend Server ----
PORT=3001
